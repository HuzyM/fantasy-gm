    "test:browser": "npm run build && node scripts/verify-browser.mjs"
  },
  "dependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "lucide-react": "1.59.0",
